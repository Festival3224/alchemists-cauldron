
#!/bin/sh

commit_message=$(cat "$1")

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9/-]+\))?!?: .+'

if ! printf '%s\n' "$commit_message" | grep -Eq "$pattern"; then
  echo "Invalid commit message format."
  echo "Expected: type(scope): description or type: description"
  echo "Example: feat: add ingredient shelf"
  exit 1
fi
